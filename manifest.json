{
  "manifest_version": 3,
  "name": "Productivity application",
  "version": "0.1",
  "description": "making chrome productivity specific",

  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  
  "permissions": ["storage"],

  "host_permissions": ["https://www.google.com/*"],

  "content_scripts": [
    {
      "matches": ["https://www.google.com/search*"],
      "js": ["js/googleDictionaryIntegration.js"]
    }
  ]
}
